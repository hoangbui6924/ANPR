# Settings for "docker compose up" (copy to .env; .env is not committed)
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-8-chars
# port of the website on this machine (80 is often taken)
WEB_PORT=8080
